# =============================================================================
# .gitignore - SoftwareCenter
# Basierend auf .gitignore-template
# =============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Virtuelle Umgebungen ----
venv/
.venv/
env/
.env/

# ---- Interne Steuerungsdateien (NIEMALS in Git!) ----
AUFGABEN.txt
TEST.txt
TESTS.txt
TESTERGEBNISSE.txt
BUGREPORT.md
DIAGNOSE_REPORT.md
LOCK*.txt

# ---- Persoenliche / Sensible Daten ----
_USER/
.env
.env.*
credentials.json
client_secret*.json
token.json
secrets.*
*.pfx
*.p12
*.cer
*.crt
*.pem
*.key
keyring/

# ---- Build-Artefakte & Releases ----
releases/
*.exe
*.msi
*.msix
*.appx
*.spec
!SoftwareCenter.spec
*.log
*.tmp
*.bak
*.db
*.sqlite
*.sqlite3

# ---- Bugsweep-Backups ----
*_BUGSWEEP_PRE_*
*_BUGSWEEP_FINAL_*
*_FINAL_*

# ---- IDE & Editoren ----
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Betriebssystem & Cloud-Sync ----
desktop.ini
Thumbs.db
.DS_Store
ehthumbs.db
*conflicted copy*
* (kopie)*
* (Kopie)*
* (copy)*
* (Copy)*
*-ASUS*
*-ASUS-GEI*
*-WORKSTATION*
*-WORKSTATION-LG*
*-LAPTOP*
*-Mac Studio*
*-MacBook*
*.sync-conflict-*
*.conflict
*-conflict-*
*-CONFLIT-*
*.orig
*.rej
DECISIONS.md
PORTIERUNGSPLAN.md
TODO.md
DONE.md

# ---- Lock-Dateien & Multi-Agent ----
LOCK
LOCK.*
LOCK*.txt
*.lock
LOCK.user.*
LOCK.until.*
LOCK.condition.*
LOCK.permissions.json
.automation-lock
uv.lock
!package-lock.json

# ---- Test-, Cache- & Wheel-Artefakte ----
.coverage.*
coverage/
.wheel-smoke/
wheelhouse/
.hypothesis/
.turbo/
.nyc_output/
.tox/
pytest_out.txt
pytest*.txt

# Personal-Builds (BUILD-VERFAHREN §9) und lokale Backups
*-personal.exe
SoftwareCenter_PRE_*.py

# ---- Agenten-interne Arbeitsnotizen (GITHUB-POLICY.md §3, T-20260926-510472849) ----
BEFUNDE.md
*MARKETING-LOG.txt
*STATUS-LOG.txt
*_DAILY_CARE.md
STORE_CONTRACT.md
STORE_READINESS.md
_WARTUNG/
_STAGING/
